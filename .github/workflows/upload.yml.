name: Upload to App Store Connect

on:
  release:
    types: [published]
  workflow_dispatch:

jobs:
  upload:
    runs-on: macos-latest
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Download Signed IPA from Release
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          gh release download --pattern "*.ipa" --dir .
          IPA_PATH=$(ls *.ipa | head -n 1)
          echo "IPA_FILE=$IPA_PATH" >> $GITHUB_ENV

      - name: Setup Apple API Key
        env:
          API_KEY: ${{ secrets.APP_STORE_CONNECT_PRIVATE_KEY }}
          KEY_ID: ${{ secrets.APP_STORE_CONNECT_KEY_ID }}
        run: |
          mkdir -p ~/.appstoreconnect/private_keys ~/.private_keys
          echo "$API_KEY" > ~/.appstoreconnect/private_keys/AuthKey_${KEY_ID}.p8
          echo "$API_KEY" > ~/.private_keys/AuthKey_${KEY_ID}.p8

      - name: Upload to TestFlight / App Store Connect
        env:
          KEY_ID: ${{ secrets.APP_STORE_CONNECT_KEY_ID }}
          ISSUER_ID: ${{ secrets.APP_STORE_CONNECT_ISSUER_ID }}
        run: |
          xcrun altool --upload-app -f "$IPA_FILE" -t ios --apiKey "$KEY_ID" --apiIssuer "$ISSUER_ID"
